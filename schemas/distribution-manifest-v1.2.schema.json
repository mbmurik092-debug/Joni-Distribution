{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joni.local/schemas/distribution-manifest-v1.2.json",
  "title": "Joni Distribution Manifest v1.2",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "product",
    "assistant",
    "channel",
    "release",
    "minimum_launcher_version",
    "sequence",
    "issued_at",
    "expires_at",
    "signing_key_id",
    "trust_tier",
    "profiles",
    "components"
  ],
  "properties": {
    "schema_version": { "const": "1.2" },
    "manifest_type": { "const": "joni-distribution" },
    "product": { "const": "Personal AI" },
    "assistant": { "const": "Джони" },
    "channel": { "enum": ["stable", "beta", "dev"] },
    "sequence": { "type": "integer", "minimum": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "priority", "requirements", "roots"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer" },
          "requirements": { "type": "object" },
          "roots": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "platform",
          "artifact",
          "size",
          "sha256",
          "critical",
          "repairable",
          "removable",
          "dependencies",
          "install_path",
          "sources",
          "health"
        ]
      }
    }
  },
  "additionalProperties": true
}
