{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joni.local/schemas/distribution-manifest-v1.json",
  "title": "Joni Distribution Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "product",
    "assistant",
    "channel",
    "release",
    "minimum_launcher_version",
    "profile",
    "components"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "manifest_type": { "const": "joni-distribution" },
    "product": { "const": "Personal AI" },
    "assistant": { "const": "Джони" },
    "channel": { "enum": ["stable", "beta", "dev"] },
    "release": { "type": "string", "minLength": 1 },
    "minimum_launcher_version": { "type": "string", "minLength": 1 },
    "profile": {
      "type": "object",
      "required": ["id", "os", "arch", "min_ram_gb", "gpu_required"],
      "properties": {
        "id": { "type": "string" },
        "os": { "const": "windows" },
        "arch": { "const": "x64" },
        "min_ram_gb": { "type": "number", "minimum": 1 },
        "gpu_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "platform",
          "artifact",
          "size",
          "sha256",
          "critical",
          "repairable",
          "removable",
          "dependencies",
          "install_path",
          "sources",
          "health"
        ]
      }
    }
  },
  "additionalProperties": true
}
